# Local PostgreSQL connection string. Replace with your own database URL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/trekdesk
PORT=3000
NODE_ENV=development

# Comma-separated frontend origins. Add your deployed frontend origin when integrating.
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
